{
  "name": "diversion-vscode",
  "displayName": "Diversion",
  "description": "Source control integration for Diversion (https://www.diversion.dev) — register Diversion as a first-class SCM provider in VS Code.",
  "version": "0.3.14",
  "publisher": "mtuska",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtuska/diversion-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/mtuska/diversion-vscode/issues"
  },
  "homepage": "https://github.com/mtuska/diversion-vscode#readme",
  "engines": {
    "vscode": "^1.93.0"
  },
  "enabledApiProposals": [
    "scmHistoryProvider"
  ],
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.diversion",
    "workspaceContains:**/.diversion",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "diversion.refresh",
        "title": "Refresh",
        "category": "Diversion",
        "icon": "$(refresh)"
      },
      {
        "command": "diversion.commit",
        "title": "Commit",
        "category": "Diversion",
        "icon": "$(check)"
      },
      {
        "command": "diversion.commitSelected",
        "title": "Commit Selected",
        "category": "Diversion"
      },
      {
        "command": "diversion.stage",
        "title": "Stage Changes",
        "category": "Diversion",
        "icon": "$(add)"
      },
      {
        "command": "diversion.unstage",
        "title": "Unstage Changes",
        "category": "Diversion",
        "icon": "$(remove)"
      },
      {
        "command": "diversion.stageAll",
        "title": "Stage All Changes",
        "category": "Diversion",
        "icon": "$(add)"
      },
      {
        "command": "diversion.unstageAll",
        "title": "Unstage All Changes",
        "category": "Diversion",
        "icon": "$(remove)"
      },
      {
        "command": "diversion.openResource",
        "title": "Open",
        "category": "Diversion"
      },
      {
        "command": "diversion.openFile",
        "title": "Open File",
        "category": "Diversion",
        "icon": "$(go-to-file)"
      },
      {
        "command": "diversion.discardChanges",
        "title": "Discard Changes",
        "category": "Diversion",
        "icon": "$(discard)"
      },
      {
        "command": "diversion.discardAll",
        "title": "Discard All Changes",
        "category": "Diversion"
      },
      {
        "command": "diversion.viewHistory",
        "title": "View History",
        "category": "Diversion"
      },
      {
        "command": "diversion.openInWeb",
        "title": "Open in Web UI",
        "category": "Diversion"
      },
      {
        "command": "diversion.switchBranch",
        "title": "Switch Branch",
        "category": "Diversion"
      },
      {
        "command": "diversion.createBranch",
        "title": "Create Branch",
        "category": "Diversion"
      },
      {
        "command": "diversion.merge",
        "title": "Merge Into Current",
        "category": "Diversion"
      },
      {
        "command": "diversion.lockFile",
        "title": "Lock File",
        "category": "Diversion",
        "icon": "$(lock)"
      },
      {
        "command": "diversion.unlockFile",
        "title": "Unlock File",
        "category": "Diversion",
        "icon": "$(unlock)"
      },
      {
        "command": "diversion.listLocks",
        "title": "List Locks",
        "category": "Diversion"
      },
      {
        "command": "diversion.resolveConflict",
        "title": "Resolve Conflict",
        "category": "Diversion"
      },
      {
        "command": "diversion.markResolved",
        "title": "Mark Conflict Resolved",
        "category": "Diversion"
      },
      {
        "command": "diversion.showOutput",
        "title": "Show Output",
        "category": "Diversion"
      },
      {
        "command": "diversion.moreActions",
        "title": "More Actions...",
        "category": "Diversion",
        "icon": "$(ellipsis)"
      },
      {
        "command": "diversion.pauseSync",
        "title": "Pause Sync",
        "category": "Diversion",
        "icon": "$(debug-pause)"
      },
      {
        "command": "diversion.resumeSync",
        "title": "Resume Sync",
        "category": "Diversion",
        "icon": "$(debug-continue)"
      },
      {
        "command": "diversion.updateWorkspace",
        "title": "Update Workspace",
        "category": "Diversion",
        "icon": "$(sync)"
      },
      {
        "command": "diversion.verify",
        "title": "Verify Repository Integrity",
        "category": "Diversion"
      },
      {
        "command": "diversion.toggleBlame",
        "title": "Toggle Blame (Annotation)",
        "category": "Diversion",
        "icon": "$(eye)"
      },
      {
        "command": "diversion.daemonHealth",
        "title": "Show Daemon Health",
        "category": "Diversion"
      },
      {
        "command": "diversion.perfTrace",
        "title": "Run Performance Trace",
        "category": "Diversion"
      },
      {
        "command": "diversion.clearCommitCache",
        "title": "Clear Commit Content Cache",
        "category": "Diversion"
      },
      {
        "command": "diversion.cherryPickCommit",
        "title": "Cherry-pick Commit",
        "category": "Diversion"
      },
      {
        "command": "diversion.revertCommit",
        "title": "Revert Commit",
        "category": "Diversion"
      },
      {
        "command": "diversion.revertToCommit",
        "title": "Restore Workspace To Commit",
        "category": "Diversion"
      },
      {
        "command": "diversion.refreshShelves",
        "title": "Refresh Shelves",
        "category": "Diversion",
        "icon": "$(refresh)"
      },
      {
        "command": "diversion.createShelf",
        "title": "Create Shelf...",
        "category": "Diversion",
        "icon": "$(add)"
      },
      {
        "command": "diversion.applyShelf",
        "title": "Apply Shelf",
        "category": "Diversion",
        "icon": "$(arrow-down)"
      },
      {
        "command": "diversion.deleteShelf",
        "title": "Delete Shelf",
        "category": "Diversion",
        "icon": "$(trash)"
      },
      {
        "command": "diversion.renameShelf",
        "title": "Rename Shelf",
        "category": "Diversion",
        "icon": "$(edit)"
      },
      {
        "command": "diversion.shelveAndSwitchBranch",
        "title": "Shelve Changes and Switch Branch...",
        "category": "Diversion"
      }
    ],
    "configuration": {
      "title": "Diversion",
      "properties": {
        "diversion.path": {
          "type": "string",
          "default": "",
          "description": "Path to the `dv` binary. Empty uses the system PATH lookup."
        },
        "diversion.daemonUrl": {
          "type": "string",
          "default": "",
          "description": "Override the Diversion daemon URL (e.g. http://127.0.0.1:38825). Empty discovers via ~/.diversion/.port."
        },
        "diversion.refresh.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "description": "Debounce window for auto-refresh after file changes."
        },
        "diversion.maxParallelProcesses": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 32,
          "description": "Maximum number of `dv` CLI processes the extension will run concurrently. Higher values speed up bulk operations like loading commit data in the SCM Graph at the cost of more CPU and daemon load."
        },
        "diversion.binaryExtensions": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional file extensions (with leading dot, e.g. \".uplugin\") to treat as binary on top of the built-in list. Binary files skip the side-by-side diff view and open directly."
        },
        "diversion.scm.showAllRepoChanges": {
          "type": "boolean",
          "default": false,
          "description": "When opening a sub-directory of a Diversion repo, the SCM panel only shows changes inside the open folder(s) by default. Enable this to see ALL changes in the repo regardless of which folder you opened."
        },
        "diversion.log.level": {
          "type": "string",
          "enum": ["off", "error", "warn", "info", "debug"],
          "default": "info",
          "description": "Verbosity of the Diversion output channel."
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "diversion.shelves",
          "name": "Diversion Shelves",
          "when": "diversion.hasRepo"
        }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "diversion.createShelf", "when": "view == diversion.shelves", "group": "navigation@1" },
        { "command": "diversion.refreshShelves", "when": "view == diversion.shelves", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "diversion.applyShelf", "when": "view == diversion.shelves && viewItem == diversion.shelf", "group": "1_actions@1" },
        { "command": "diversion.applyShelf", "when": "view == diversion.shelves && viewItem == diversion.shelf", "group": "inline@1" },
        { "command": "diversion.renameShelf", "when": "view == diversion.shelves && viewItem == diversion.shelf", "group": "1_actions@2" },
        { "command": "diversion.deleteShelf", "when": "view == diversion.shelves && viewItem == diversion.shelf", "group": "1_actions@3" },
        { "command": "diversion.deleteShelf", "when": "view == diversion.shelves && viewItem == diversion.shelf", "group": "inline@2" }
      ],
      "scm/title": [
        { "command": "diversion.commit", "when": "scmProvider == diversion", "group": "navigation@1" },
        { "command": "diversion.refresh", "when": "scmProvider == diversion", "group": "navigation@2" }
      ],
      "scm/sourceControl": [
        { "command": "diversion.commit", "when": "scmProvider == diversion", "group": "1_actions@1" },
        { "command": "diversion.discardAll", "when": "scmProvider == diversion", "group": "1_actions@2" },
        { "command": "diversion.refresh", "when": "scmProvider == diversion", "group": "1_actions@3" },

        { "command": "diversion.switchBranch", "when": "scmProvider == diversion", "group": "2_branch@1" },
        { "command": "diversion.createBranch", "when": "scmProvider == diversion", "group": "2_branch@2" },
        { "command": "diversion.merge", "when": "scmProvider == diversion", "group": "2_branch@3" },

        { "command": "diversion.updateWorkspace", "when": "scmProvider == diversion", "group": "3_sync@1" },
        { "command": "diversion.pauseSync", "when": "scmProvider == diversion", "group": "3_sync@2" },
        { "command": "diversion.resumeSync", "when": "scmProvider == diversion", "group": "3_sync@3" },

        { "command": "diversion.lockFile", "when": "scmProvider == diversion", "group": "4_locks@1" },
        { "command": "diversion.unlockFile", "when": "scmProvider == diversion", "group": "4_locks@2" },
        { "command": "diversion.listLocks", "when": "scmProvider == diversion", "group": "4_locks@3" },

        { "command": "diversion.createShelf", "when": "scmProvider == diversion", "group": "5_shelves@1" },
        { "command": "diversion.applyShelf", "when": "scmProvider == diversion", "group": "5_shelves@2" },
        { "command": "diversion.shelveAndSwitchBranch", "when": "scmProvider == diversion", "group": "5_shelves@3" },

        { "command": "diversion.viewHistory", "when": "scmProvider == diversion", "group": "5_view@2" },
        { "command": "diversion.openInWeb", "when": "scmProvider == diversion", "group": "5_view@3" },
        { "command": "diversion.toggleBlame", "when": "scmProvider == diversion", "group": "5_view@4" },
        { "command": "diversion.verify", "when": "scmProvider == diversion", "group": "5_view@5" },
        { "command": "diversion.daemonHealth", "when": "scmProvider == diversion", "group": "5_view@6" },
        { "command": "diversion.perfTrace", "when": "scmProvider == diversion", "group": "5_view@7" },
        { "command": "diversion.showOutput", "when": "scmProvider == diversion", "group": "5_view@8" }
      ],
      "scm/resourceState/context": [
        {
          "command": "diversion.openFile",
          "when": "scmProvider == diversion",
          "group": "navigation"
        },

        {
          "command": "diversion.openFile",
          "when": "scmProvider == diversion",
          "group": "inline@1"
        },
        {
          "command": "diversion.discardChanges",
          "when": "scmProvider == diversion && scmResourceState =~ /^unstaged-/",
          "group": "inline@2"
        },
        {
          "command": "diversion.stage",
          "when": "scmProvider == diversion && scmResourceState =~ /^unstaged-/",
          "group": "inline@3"
        },
        {
          "command": "diversion.unstage",
          "when": "scmProvider == diversion && scmResourceState =~ /^staged-/",
          "group": "inline@3"
        },
        {
          "command": "diversion.markResolved",
          "when": "scmProvider == diversion && scmResourceState == conflict",
          "group": "inline@3"
        },

        {
          "command": "diversion.stage",
          "when": "scmProvider == diversion && scmResourceState =~ /^unstaged-/",
          "group": "1_modification@1"
        },
        {
          "command": "diversion.unstage",
          "when": "scmProvider == diversion && scmResourceState =~ /^staged-/",
          "group": "1_modification@1"
        },
        {
          "command": "diversion.commitSelected",
          "when": "scmProvider == diversion && scmResourceState != conflict",
          "group": "1_modification@2"
        },
        {
          "command": "diversion.discardChanges",
          "when": "scmProvider == diversion && scmResourceState =~ /^unstaged-/",
          "group": "1_modification@3"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "diversion.stageAll",
          "when": "scmProvider == diversion && scmResourceGroup == changes",
          "group": "inline"
        },
        {
          "command": "diversion.unstageAll",
          "when": "scmProvider == diversion && scmResourceGroup == staged",
          "group": "inline"
        },
        {
          "command": "diversion.stageAll",
          "when": "scmProvider == diversion && scmResourceGroup == changes",
          "group": "1_modification@1"
        },
        {
          "command": "diversion.unstageAll",
          "when": "scmProvider == diversion && scmResourceGroup == staged",
          "group": "1_modification@1"
        },
        {
          "command": "diversion.markResolved",
          "when": "scmProvider == diversion && scmResourceGroup == conflicts",
          "group": "1_conflict"
        }
      ],
      "explorer/context": [
        {
          "command": "diversion.lockFile",
          "when": "diversion.hasRepo && resourceScheme == file && !explorerResourceIsFolder",
          "group": "7_modification@1"
        },
        {
          "command": "diversion.unlockFile",
          "when": "diversion.hasRepo && resourceScheme == file && !explorerResourceIsFolder",
          "group": "7_modification@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "diversion.lockFile",
          "when": "diversion.hasRepo && resourceScheme == file",
          "group": "7_modification@1"
        },
        {
          "command": "diversion.unlockFile",
          "when": "diversion.hasRepo && resourceScheme == file",
          "group": "7_modification@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "ignore": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^2.27.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
